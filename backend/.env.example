# FastAPI 配置项
SECRET_KEY=change-me-to-a-random-secret
APP_NAME=pipixia-drama
API_VERSION=1.0.0
API_PREFIX=/api/v1
BACKEND_CORS_ORIGINS='["*"]'

# 日志配置
LOG_LEVEL=DEBUG
LOG_FILE_RETENTION=90 days
LOG_FILE_MAX_SIZE=50 MB
LOG_DB_RETENTION_DAYS=365
LOG_REDIS_DB=1
LOG_FLUSH_INTERVAL=5
LOG_FLUSH_BATCH_SIZE=500
LOG_REDIS_BUFFER_MAX=10000

# 数据库配置项
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_NAME=pipixia-drama
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Redis配置项
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 加密配置项
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REFRESH_TOKEN_EXPIRE_MINUTES=10080
SESSION_IDLE_TIMEOUT_MINUTES=120

# 默认账号
DEFAULT_USER_NAME=test
DEFAULT_USER_PASSWORD=123456

# 腾讯云 COS 配置
TENCENT_COS_SECRET_ID=your-tencent-cos-secret-id
TENCENT_COS_SECRET_KEY=your-tencent-cos-secret-key
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=your-bucket-name
# CDN 加速域名（可选，配置后签名 URL 使用此域名）
TENCENT_COS_DOMAIN=

# 火山私域素材库
VOLC_ACCESSKEY=your-volc-access-key
VOLC_SECRETKEY=your-volc-secret-key
ARK_API_KEY=

# BytePlus（火山引擎国际版）
VOLC_OVERSEA_ACCESSKEY=your-byteplus-access-key
VOLC_OVERSEA_SECRETKEY=your-byteplus-secret-key
BYTEPLUS_ARK_API_KEY=

# 支付
PAY_TIME_OUT=86400
PAY_SOURCE_IP=127.0.0.1
SANDPAY_ACCESS_MID=your-sandpay-merchant-id
SANDPAY_API_VERSION=4.0.0
SANDPAY_PRIVATE_KEY_PATH=/path/to/your/sandpay-private-key.pfx
SANDPAY_PUBLIC_KEY_PATH=/path/to/your/sandpay-public-key.cer
SANDPAY_PRIVATE_KEY_PASSWORD=your-sandpay-private-key-password
SANDPAY_RECHARGE_CALLBACK_URL=https://your-domain.com/api/v1/balance/recharge/pay/callback/test
SANDPAY_VIP_CALLBACK_URL=https://your-domain.com/api/v1/vip/buy/callback/test
SANDPAY_CUP_QRCODE_URL=https://openapi-uat01.sand.com.cn/v4/sd-receipts/api/trans/trans.order.create
SANDPAY_QRCODE_QUERY_URL=https://openapi-uat01.sand.com.cn/v4/sd-receipts/api/trans/trans.order.query
SANDPAY_PAYMENT_QUERY_URL=https://openapi-uat01.sand.com.cn/v4/sd-payment/api/trans/trans.payment.order.query

CALLBACK_BASE_URL=https://your-domain.com

# 视频超分(火山 AI MediaKit 画质增强)
VIDEO_SUPER_RES_API_URL=https://mediakit.cn-beijing.volces.com/api/v1/tools/enhance-video
VIDEO_SUPER_RES_API_KEY=your-video-super-res-api-key
